# Copie este arquivo para .env e informe sua chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Use true para apresentar e testar sem consumir a API do Gemini.
DEMO_MODE=true
REQUEST_TIMEOUT_SECONDS=30
# Origens externas autorizadas, separadas por vírgula. Deixe vazio para uso same-origin.
ALLOWED_ORIGINS=
GEMINI_DIAGNOSTIC_ON_STARTUP=false

